# API configuration — copy to `.env` and adjust for your environment.

# SPEAK-Server (statistics, channels, YouTube validation, admin leaderboard) — port 5000
VITE_SPEAK_SERVER_API_URL=http://localhost:5000/api/v1
VITE_SPEAK_SERVER_BASE_URL=http://localhost:5000

# Audio-Scraping-Service (processing, queue, /output static audio) — port 5001
VITE_AUDIO_SCRAPING_API_URL=http://localhost:5001/api/v1
VITE_AUDIO_SCRAPING_BASE_URL=http://localhost:5001

# Transcription-Service (/audio/random, /transcription) — port 5002
VITE_TRANSCRIPTION_API_URL=http://localhost:5002/api/v1
VITE_TRANSCRIPTION_BASE_URL=http://localhost:5002
